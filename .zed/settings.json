{
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "run": "onSave"
        }
      }
    }
  },
  "format_on_save": "on",
  "prettier": {
    "allowed": false
  },
  "formatter": [
    {
      "language_server": {
        "name": "oxfmt"
      }
    }
  ],
  "code_actions_on_format": {
    "source.fixAll.oxc": true
  }
}
